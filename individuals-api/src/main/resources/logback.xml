<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration>

<configuration scan="true">

    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>

    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Паттерн строго в ОДНУ строку: многострочный JSON Alloy не разбирает
                 (stage.json парсит построчно), поэтому такие логи не попадали в панели
                 Grafana с фильтром по level и не получали метку trace_id.
                 Имена полей совпадают с person-service (traceId/spanId). -->
            <pattern>{"timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}", "traceId": "%X{trace_id}", "spanId":"%X{span_id}", "level":"%level", "thread":"%thread", "logger":"%logger{36}","message":"%msg"}%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="console"/>
    </root>

</configuration>
